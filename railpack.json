{
  "provider": "node",
  "packages": {
    "node": "20",
    "python": "3.13"
  },
  "steps": {
    "build": {
      "commands": ["python3 -m pip install --target .python-packages -r requirements.txt", "...", "npm run build"]
    }
  },
  "deploy": {
    "startCommand": "npm start",
    "variables": {
      "PYTHONPATH": "/app/.python-packages"
    }
  }
}
