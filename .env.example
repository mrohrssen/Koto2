# JRPG Environment Variables

# Authentication
JWT_SECRET=your-random-64-char-string-here
ENCRYPTION_KEY=your-random-64-char-hex-string-here
ADMIN_SECRET=your-admin-secret-here

# JPDB API Key (for vocabulary integration)
JPDB_API_KEY=

# AI Provider API Keys (at least one required for narration)
OPENAI_API_KEY=
DEV_BEFRIEND_FALLBACK=0
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Server port (default: 3000)
PORT=3000
