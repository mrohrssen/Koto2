{
  "name": "jrpg",
  "version": "1.0.0",
  "description": "Japanese vocabulary learning RPG",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "npx concurrently --names server,vite --prefix-colors blue,green \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node --watch server.js",
    "dev:client": "vite",
    "seed:dev-user": "node src/dev/dev-test-user.js",
    "build": "node scripts/tokenize-static.js && node scripts/generate-asset-manifest.js && vite build",
    "preview": "vite preview",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "c8 node --experimental-test-module-mocks --test 'tests/unit/**/*.test.js'",
    "test:integration": "node --test 'tests/integration/**/*.test.js'",
    "test:visual": "npx playwright test --config tests/visual/playwright.config.js tests/visual/screens",
    "test:smoke": "npx playwright test --config tests/visual/playwright.config.js tests/smoke --workers=1",
    "test:smoke:node": "node --test 'tests/smoke/**/*.test.js'",
    "test:subway": "npm run seed:dev-user && npx playwright test --config tests/smoke/playwright.subway.config.js tests/smoke/kanji-kombat-subway --workers=1",
    "test:coverage": "c8 report --reporter=text --reporter=html",
    "audit:japanese-display": "node scripts/audit-japanese-display-policy.js",
    "optimize-images": "node scripts/optimize-images.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.0",
    "@capacitor-firebase/analytics": "^8.2.0",
    "@capacitor-firebase/crashlytics": "^8.2.0",
    "@capacitor/android": "^8.3.0",
    "@capacitor/app": "^8.1.0",
    "@capacitor/cli": "^8.3.0",
    "@capacitor/core": "^8.3.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.3.0",
    "@capacitor/keyboard": "^8.0.2",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@google/genai": "^1.43.0",
    "@google/generative-ai": "^0.21.0",
    "animejs": "^4.3.5",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.11.1",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^8.2.1",
    "fast-xml-parser": "^5.8.0",
    "firebase": "^12.13.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "openai": "^4.70.0",
    "openskill": "^4.1.1",
    "pixi-filters": "^6.1.5",
    "pixi.js": "^8.17.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "ts-fsrs": "^5.2.3",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "c8": "^11.0.0",
    "concurrently": "^9.1.0",
    "sharp": "^0.34.5",
    "supertest": "^7.2.2",
    "typescript": "^6.0.2",
    "vite": "^6.2.0"
  }
}
